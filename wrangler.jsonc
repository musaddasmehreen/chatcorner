{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatcorner",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {},
  "assets": {
    "directory": ".",
