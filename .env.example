# ChatCorner environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# Required: Supabase project credentials
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_URL.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: TURN server credentials for WebRTC voice calls.
# If omitted, the app falls back to public STUN servers only.
TURN_SERVER_URL=turn:your.turn.server:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential

# Deprecated / unused
# TERABOX_EMAIL=
# TERABOX_PASS=
# BACKUP_PROXY_URL=
